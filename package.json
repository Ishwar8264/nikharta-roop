{
  "name": "nikharta-roop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@nikharta-roop/web",
    "build": "turbo run build",
    "start": "pnpm --filter @nikharta-roop/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @nikharta-roop/web test:watch",
    "db:generate": "pnpm --filter @nikharta-roop/db db:generate",
    "db:migrate": "pnpm --filter @nikharta-roop/db db:migrate",
    "db:deploy": "pnpm --filter @nikharta-roop/db db:deploy",
    "db:seed": "pnpm --filter @nikharta-roop/db db:seed",
    "db:studio": "pnpm --filter @nikharta-roop/db db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @nikharta-roop/db db:validate"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "prettier": "3.9.10"
  }
}
