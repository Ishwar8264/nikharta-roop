generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================
enum UserRole {
  USER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AuthOtpPurpose {
  LOGIN
  SIGNUP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
}
enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}
enum PaymentProvider {
  RAZORPAY
  CASH
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ================= AUTH & USER =================

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id                    String    @id @default(cuid())
  mobile                String    @unique @db.VarChar(10)
  name                  String?   @db.VarChar(100)
  email                 String?   @db.VarChar(150)
  gender                Gender?
  dateOfBirth           DateTime?
  role                  UserRole  @default(USER)
  avatarUrl             String?
  isActive              Boolean   @default(true)

  // Social Login IDs
  googleId              String?   @unique
  appleId               String?   @unique

  // Verification
  mobileVerifiedAt      DateTime?
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?

  // Onboarding
  onboardingStep        Int       @default(0) // 0=not_started, 1=profile, 2=preferences, 3=first_booking, 99=completed
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  onboardingAbandonedAt DateTime?
  abandonedAtStep       Int?      // Kis step pe chhod ke gaya

  // Preferences
  referralSource        String?   @db.VarChar(100) // GOOGLE, FRIEND, INSTAGRAM, WALK_IN, etc.
  preferredBranchId     String?

  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  bookings             Booking[]
  reviews              Review[]
  payments             Payment[]
  authOtps             AuthOtp[]
  authSessions         AuthSession[]
  blogPosts            BlogPost[]
  notifications        Notification[]
  staffProfile         Staff?
  preferredBranch      Branch?        @relation(fields: [preferredBranchId], references: [id], onDelete: SetNull)
  onboardingActions    OnboardingAction[]
  favoriteServices     UserFavoriteService[]
}

// ================= ONBOARDING TRACKING =================

enum OnboardingActionType {
  STEP_STARTED
  STEP_COMPLETED
  STEP_SKIPPED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  ONBOARDING_ABANDONED
  ONBOARDING_RESUMED
}

model OnboardingAction {
  id        String                @id @default(cuid())
  userId    String
  step      Int                   // 1, 2, 3, etc.
  action    OnboardingActionType
  metadata  Json?                 // Step-specific data (e.g., {"filledFields": ["name", "email"], "timeSpentSeconds": 45})
  ipAddress String?
  userAgent String?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, step, action])
  @@index([userId, createdAt])
  @@index([action, createdAt]) // Analytics: "kitne log abandon kare" ke liye
}

model UserFavoriteService {
  userId    String
  serviceId String
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

model AuthOtp {
  id          String         @id @default(cuid())
  userId      String?
  mobile      String         @db.VarChar(10)
  purpose     AuthOtpPurpose @default(LOGIN)
  otpHash     String
  attemptCount Int           @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id             String    @id @default(cuid())
  userId         String
  tokenId        String    @unique
  refreshTokenId String?   @unique
  deviceName     String?
  ipAddress      String?
  userAgent      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

// ================= BRANCH & MAPS =================

model Branch {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(200)
  city          String   @db.VarChar(100)
  address       String
  phone         String   @db.VarChar(10)
  openTime      DateTime @db.Time(0)
  closeTime     DateTime @db.Time(0)
  
  googleMapsUrl String?
  placeId       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  isActive      Boolean  @default(true)
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff         Staff[]
  services      Service[]
  bookings      Booking[]
  categories    ServiceCategory[]
}

// ================= SERVICES & STAFF =================

model ServiceCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String   @db.VarChar(200)
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services Service[]
}

enum ServiceGender {
  MALE
  FEMALE
  UNISEX
}

model Service {
  id              String        @id @default(cuid())
  branchId        String
  categoryId      String?
  name            String        @db.VarChar(200)
  description     String?
  gender          ServiceGender @default(UNISEX)
  priceMale       Decimal?      @db.Decimal(10, 2)
  priceFemale     Decimal?      @db.Decimal(10, 2)
  price           Decimal       @db.Decimal(10, 2)
  advanceAmount   Decimal?      @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean       @default(true)
  deletedAt       DateTime? // Soft delete
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookings    Booking[]
  staffSkills StaffSkill[]
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Staff {
  id               String         @id @default(cuid())
  userId           String         @unique
  branchId         String
  name             String         @db.VarChar(100)
  specialization   String[]       @default([])
  photoUrl         String?
  rating           Decimal        @default(0) @db.Decimal(3, 2)
  commissionType   CommissionType? @default(PERCENTAGE)
  commissionValue  Decimal?       @db.Decimal(10, 2)
  isAvailable      Boolean        @default(true)
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  reviews    Review[]
  staffSkills StaffSkill[]
}

model StaffSkill {
  staffId   String
  serviceId String

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// ================= BOOKING & PAYMENTS =================

model Booking {
  id            String        @id @default(cuid())
  displayId     String        @unique @db.VarChar(30)
  userId        String
  branchId      String
  staffId       String?
  serviceId     String
  bookingDate   DateTime      @db.Date
  slotStart     DateTime      @db.Time(0)
  slotEnd       DateTime      @db.Time(0)
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  advanceAmount Decimal       @default(0) @db.Decimal(10, 2)
  advancePaid   Decimal       @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal     @default(0) @db.Decimal(10, 2)
  paymentMode   String?       @db.VarChar(20) // FULL, SPLIT
  notes         String?
  cancelledAt   DateTime?
  noShowAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments Payment[]
  review   Review?
  notifications Notification[]

  // DOUBLE BOOKING SE BACHNE KE LIYE (Yeh add kiya hai)
  @@unique([staffId, bookingDate, slotStart])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String
  userId            String
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  status            PaymentStatus   @default(CREATED)
  amount            Decimal         @db.Decimal(10, 2)
  amountPaid        Decimal         @default(0) @db.Decimal(10, 2)
  paidAt            DateTime?
  paymentType       String?         @db.VarChar(20) // ADVANCE, REMAINING, FULL
  createdAt         DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  staffId   String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

// ================= NOTIFICATIONS =================

model Notification {
  id        String                @id @default(cuid())
  userId    String?
  bookingId String?
  channel   NotificationChannel
  recipient String
  subject   String?
  message   String
  status    NotificationStatus    @default(QUEUED)
  sentAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime              @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ================= BLOG FOR SEO =================

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(220)
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String         @db.VarChar(240)
  slug        String         @unique @db.VarChar(260)
  excerpt     String?
  content     String
  coverImage  String?
  metaTitle   String?
  metaDesc    String?
  categoryId  String
  authorId    String?
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
}



model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  bookingId      String
  amount         Decimal      @db.Decimal(10, 2)
  reason         String?      // e.g., "User cancelled", "No Show", "Service not delivered"
  status         RefundStatus @default(PENDING) // PENDING, PROCESSED, FAILED
  processedBy    String?      // Admin/Staff ID jisne refund kiya
  processedAt    DateTime?
  refundType     String?      @db.VarChar(20) // ADVANCE, FULL, PARTIAL
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
}
