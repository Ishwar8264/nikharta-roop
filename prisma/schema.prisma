datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ---------- ENUMS ----------
enum PlatformRole {
  SUPER_ADMIN
  USER
}



enum SalonMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum OtpChannel {
  EMAIL
  PHONE
  WHATSAPP
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  ONLINE
}

enum AiContextType {
  GENERAL
  STAFF
  PRODUCT
  SERVICE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum SalonCategory {
  MALE
  FEMALE
  UNISEX
  KIDS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum LoyaltyTxnType {
  EARNED
  REDEEMED
  EXPIRED
  REFUNDED
}

// ---------- USER & AUTH ----------
model User {
  id       String       @id @default(uuid())
  email    String?      @unique
  phone    String?      @unique
  password String?
  name     String?
  avatar   String?
  bio      String?
  role     PlatformRole @default(USER)

  lat Float?
  lng Float?

  isOnboarded Boolean @default(false)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Loyalty
  loyaltyPoints Int @default(0)

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps                 Otp[]
  refreshTokens        RefreshToken[]
  socialAccounts       SocialAccount[]
  salonMemberships     SalonMember[]
  appointments         Appointment[]
  favorites            Favorite[]
  serviceReviews       ServiceReview[]
  productReviews       ProductReview[]
  blogPosts            BlogPost[]
  blogComments         BlogComment[]
  aiChats              AiChat[]
  aiUsage              UserAiUsage?
  aiUsageLogs          AiUsageLog[]
  notifications        Notification[]
  loyaltyTxns          LoyaltyTransaction[]
  staffRatingsGiven    StaffRating[]        @relation("StaffRatingCustomer")
  staffRatingsReceived StaffRating[]        @relation("StaffRatingStaff")
  staffSchedules       StaffSchedule[]
  staffLeaves          StaffLeave[]
  primaryAppointments  Appointment[]        @relation("AppointmentPrimaryStaff")
  appointmentServices  AppointmentService[] @relation("AppointmentServiceStaff")
  staffSkills          StaffServiceSkill[]

  @@index([role])
  @@index([deletedAt])
}

model Otp {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  channel     OtpChannel
  purpose     OtpPurpose @default(EMAIL_VERIFICATION)   // ← ADD
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  isUsed      Boolean    @default(false)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([userId, isUsed])
  @@index([userId, purpose, isUsed])                    // ← ADD
}

// Refresh token for JWT rotation
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String? // Device info
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SocialAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

// ---------- SALON & STAFF ----------
model Salon {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  category    SalonCategory @default(UNISEX)
  address     String
  city        String
  state       String
  zip         String
  country     String        @default("IN")
  timezone    String        @default("Asia/Kolkata")
  lat         Float
  lng         Float
  placeId     String?       @unique

  phone  String?
  email  String?
  images String[] // Gallery

  // SEO
  seoTitle       String?
  seoDescription String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members        SalonMember[]
  workingHours   SalonWorkingHours[]
  services       Service[]
  products       Product[]
  appointments   Appointment[]
  favorites      Favorite[]
  staffSchedules StaffSchedule[]
  staffLeaves    StaffLeave[]

  @@index([city])
  @@index([isActive])
}

// Salon ke weekly working hours
model SalonWorkingHours {
  id        String    @id @default(uuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  day       DayOfWeek
  openTime  String // "09:00"
  closeTime String // "21:00"
  isClosed  Boolean   @default(false) // Weekly off

  @@unique([salonId, day])
}

model SalonMember {
  id      String          @id @default(uuid())
  userId  String
  salonId String
  role    SalonMemberRole

  user  User  @relation(fields: [userId], references: [id])
  salon Salon @relation(fields: [salonId], references: [id])

  @@unique([userId, salonId])
  @@index([salonId, role])
}

// Staff ka weekly schedule
model StaffSchedule {
  id        String    @id @default(uuid())
  staffId   String
  staff     User      @relation(fields: [staffId], references: [id])
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  day       DayOfWeek
  startTime String // "10:00"
  endTime   String // "19:00"
  isOff     Boolean   @default(false)

  @@unique([staffId, salonId, day])
}

// Staff ki leave
model StaffLeave {
  id        String   @id @default(uuid())
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId, salonId, startDate, endDate])
}

// ---------- SERVICE CATEGORIES ----------
model ServiceCategory {
  id       String    @id @default(uuid())
  name     String // "Hair", "Skin", "Nails", "Beard"
  slug     String    @unique
  icon     String?
  services Service[]
}

// ---------- SERVICES & PRODUCTS ----------
model Service {
  id         String           @id @default(uuid())
  salonId    String
  salon      Salon            @relation(fields: [salonId], references: [id])
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  name      String
  slug      String
  price     Decimal   @db.Decimal(12, 2)
  duration  Int // minutes
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  // Description (same as product - flexible)
  shortDescription String?
  description      String?
  descriptionHtml  String?
  descriptionJson  String?

  // SEO
  seoTitle       String?
  seoDescription String?

  images String[]

  reviews      ServiceReview[]
  appointments AppointmentService[]
  favorites    Favorite[]
  staffSkills  StaffServiceSkill[]

  @@unique([salonId, slug])
  @@index([salonId, isActive, deletedAt])
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id         String           @id @default(uuid())
  salonId    String
  salon      Salon            @relation(fields: [salonId], references: [id])
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  name      String
  price     Decimal   @db.Decimal(12, 2)
  stock     Int
  images    String[]
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  slug             String
  shortDescription String?
  description      String?
  descriptionHtml  String?
  descriptionJson  String?

  seoTitle       String?
  seoDescription String?

  reviews   ProductReview[]
  favorites Favorite[]

  @@unique([salonId, slug])
  @@index([salonId, isActive, deletedAt])
}

// Staff ↔ Service (kaunsa staff kaunsi service deta hai)
model StaffServiceSkill {
  id         String   @id @default(uuid())
  staffId    String
  serviceId  String
  experience Int? // years
  createdAt  DateTime @default(now())
  staff      User     @relation(fields: [staffId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([staffId, serviceId])
}

// ---------- FAVORITES ----------
model Favorite {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  salonId String?
  salon   Salon?  @relation(fields: [salonId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- REVIEWS ----------
model ServiceReview {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  images    String[] // Review photos
  createdAt DateTime @default(now())

  @@unique([serviceId, userId])
  @@index([serviceId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

// ---------- STAFF RATINGS ----------
model StaffRating {
  id      String @id @default(uuid())
  staffId String
  staff   User   @relation("StaffRatingStaff", fields: [staffId], references: [id])

  customerId String
  customer   User   @relation("StaffRatingCustomer", fields: [customerId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([appointmentId, staffId])
  @@index([staffId])
}

// ---------- COUPONS ----------
model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2) // % ya flat amount
  minOrderAmount Decimal?     @db.Decimal(12, 2) // Minimum appointment total
  maxDiscount    Decimal?     @db.Decimal(12, 2) // Cap for percentage
  usageLimit     Int? // Total uses
  usedCount      Int          @default(0)
  perUserLimit   Int          @default(1)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  appointments Appointment[]
}

// ---------- BOOKINGS & PAYMENTS ----------
model Appointment {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  staffId String? // Primary staff assigned
  staff   User?   @relation("AppointmentPrimaryStaff", fields: [staffId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  notes           String?
  cancelReason    String?
  rescheduledFrom String? // Original appointment ID

  services     AppointmentService[]
  payment      Payment?
  staffRatings StaffRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([salonId, startTime])
  @@index([staffId, startTime, endTime])
  @@index([status])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  staffId       String? // Specific staff for this service
  staff         User?       @relation("AppointmentServiceStaff", fields: [staffId], references: [id])
  price         Decimal     @db.Decimal(12, 2) // Price at time of booking
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([staffId])
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CASH)
  transactionId String?
  gatewayRef    String? // Razorpay/Stripe reference
  refundAmount  Decimal?      @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
}

// ---------- LOYALTY (Nikharata Points) ----------
model LoyaltyTransaction {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  points      Int // +/- points
  type        LoyaltyTxnType
  description String?
  referenceId String? // Appointment ID etc.
  createdAt   DateTime       @default(now())

  @@index([userId])
}

// ---------- NOTIFICATIONS ----------
model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  data      String? // JSON payload
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, status])
}

// ---------- AUDIT LOG ----------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String? // Kaun kiya (Admin/Staff)
  action    String // "CREATE", "UPDATE", "DELETE"
  entity    String // "Salon", "Service", etc.
  entityId  String?
  oldData   String? // JSON
  newData   String? // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// ---------- AI FEATURE ----------
model UserAiUsage {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  dailyLimit   Int      @default(500)
  dailyUsed    Int      @default(0)
  dailyResetAt DateTime

  weeklyLimit   Int      @default(3000)
  weeklyUsed    Int      @default(0)
  weeklyResetAt DateTime

  monthlyLimit   Int      @default(10000)
  monthlyUsed    Int      @default(0)
  monthlyResetAt DateTime

  isBlocked   Boolean @default(false)
  blockReason String?

  updatedAt DateTime @updatedAt
}

model AiUsageLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  chatId String?
  chat   AiChat? @relation(fields: [chatId], references: [id])

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  model       String
  cost        Float? // USD me track karo
  contextType AiContextType @default(GENERAL)
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AiChat {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  title  String?

  contextType AiContextType @default(GENERAL)
  contextId   String?

  createdAt DateTime     @default(now())
  messages  AiMessage[]
  usageLogs AiUsageLog[]
}

model AiMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id])
  role      String
  content   String
  tokens    Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- BLOG SYSTEM ----------
model BlogPost {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  excerpt     String?
  content     String
  contentHtml String?
  contentJson String?

  coverImage  String?
  readingTime Int     @default(0)
  views       Int     @default(0) // Analytics

  published   Boolean   @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?

  seoTitle       String?
  seoDescription String?
  metaKeywords   String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)
  tldr           String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  tags     BlogTag[]
  comments BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt(sort: Desc)])
  @@index([slug])
}

model BlogComment {
  id         String   @id @default(uuid())
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String
  parentId   String? // Nested replies
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId])
}

model BlogCategory {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  posts          BlogPost[]
}

model BlogTag {
  id    String     @id @default(uuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}
