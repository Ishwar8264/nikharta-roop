generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  USER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AuthOtpPurpose {
  LOGIN
  SIGNUP
  PHONE_VERIFICATION
}

enum AuthEventType {
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  SIGNUP_STARTED
  SIGNUP_COMPLETED
  LOGIN_COMPLETED
  LOGOUT_COMPLETED
  TOKEN_REVOKED
  ACCOUNT_SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASH
  UPI_OFFLINE
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  FALLBACK_SENT
}

enum NotificationTrigger {
  OTP_REQUEST
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED_BY_USER
  BOOKING_CANCELLED_BY_ADMIN
  SERVICE_COMPLETED
  REVIEW_REQUEST
  OFFER_LAUNCHED
  LOYALTY_MILESTONE
  NO_SHOW_DETECTED
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
  DEDUCTED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductSaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum InventoryTransactionType {
  PURCHASE
  SERVICE_USAGE
  PRODUCT_SALE
  ADJUSTMENT
  WASTAGE
  RETURN
}

enum ExpenseCategory {
  RENT
  SALARY
  PRODUCT_PURCHASE
  UTILITIES
  MARKETING
  MAINTENANCE
  REFUND_COST
  OTHER
}

enum StaffCommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum MediaOwnerType {
  SERVICE
  PACKAGE
  STAFF
  PORTFOLIO
  REVIEW
  BLOG_POST
  PRODUCT
  BRANCH
}

model User {
  id                      String    @id @default(cuid())
  mobile                  String    @unique @db.VarChar(10)
  name                    String?   @db.VarChar(100)
  email                   String?   @db.VarChar(150)
  role                    UserRole  @default(USER)
  branchId                String?
  avatarUrl               String?
  loyaltyPoints           Int       @default(0)
  isActive                Boolean   @default(true)
  mobileVerifiedAt        DateTime?
  profileCompletedAt      DateTime?
  notificationPreferences Json      @default("{}")
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  branch                 Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staffProfile           Staff?
  bookings               Booking[]              @relation("CustomerBookings")
  createdBookings        Booking[]              @relation("CreatedBookings")
  reviews                Review[]
  payments               Payment[]
  offerRedemptions       OfferRedemption[]
  loyaltyTransactions    LoyaltyTransaction[]
  notifications          Notification[]
  blogPosts              BlogPost[]             @relation("BlogAuthor")
  authSessions           AuthSession[]
  authOtps               AuthOtp[]
  authEvents             AuthEvent[]
  changedBookingStatuses BookingStatusHistory[]
  productSales           ProductSale[]
  addresses              CustomerAddress[]
  consultations          Consultation[]
  expensesCreated        Expense[]              @relation("ExpenseCreatedBy")

  @@index([branchId])
  @@index([role, isActive])
}

model AuthSession {
  id             String    @id @default(cuid())
  userId         String
  tokenId        String    @unique
  refreshTokenId String?   @unique
  deviceName     String?
  ipAddress      String?
  userAgent      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model AuthOtp {
  id                String         @id @default(cuid())
  userId            String?
  mobile            String         @db.VarChar(10)
  purpose           AuthOtpPurpose @default(LOGIN)
  otpHash           String
  attemptCount      Int            @default(0)
  maxAttempts       Int            @default(3)
  retryAfter        Int            @default(30)
  expiresAt         DateTime
  verifiedAt        DateTime?
  lockedUntil       DateTime?
  ipAddress         String?
  userAgent         String?
  provider          String?        @db.VarChar(80)
  providerMessageId String?
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@index([lockedUntil])
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  mobile    String?       @db.VarChar(10)
  type      AuthEventType
  ipAddress String?
  userAgent String?
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([mobile, createdAt])
  @@index([type, createdAt])
}

model Branch {
  id            String   @id @default(cuid())
  nameHi        String   @db.VarChar(200)
  nameEn        String?  @db.VarChar(200)
  city          String   @db.VarChar(100)
  address       String
  googleMapsUrl String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  placeId       String?  @db.VarChar(200)
  phone         String   @db.VarChar(10)
  openTime      DateTime @db.Time(0)
  closeTime     DateTime @db.Time(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users             User[]
  categories        ServiceCategory[]
  services          Service[]
  packages          Package[]
  staff             Staff[]
  bookings          Booking[]
  offers            Offer[]
  productCategories ProductCategory[]
  products          Product[]
  productSales      ProductSale[]
  consultations     Consultation[]
  customerAddresses CustomerAddress[]
  serviceAddOns     ServiceAddOn[]
  holidays          BranchHoliday[]
  notifications     Notification[]
  revenueReports    RevenueSnapshot[]
  portfolioItems    PortfolioItem[]
  inventoryItems    InventoryItem[]
  expenses          Expense[]
  mediaAssets       MediaAsset[]

  @@index([city, isActive])
}

model BranchHoliday {
  id        String   @id @default(cuid())
  branchId  String
  date      DateTime @db.Date
  reasonHi  String?
  reasonEn  String?
  isClosed  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
}

model ServiceCategory {
  id              String   @id @default(cuid())
  branchId        String?
  slugScope       String   @default("global") @db.VarChar(120)
  nameHi          String   @db.VarChar(200)
  nameEn          String   @db.VarChar(200)
  slug            String   @db.VarChar(220)
  description     String?
  descriptionJson Json?
  descriptionHtml String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services Service[]
  packages Package[]

  @@unique([branchId, slug])
  @@unique([slugScope, slug])
  @@index([branchId, isActive])
  @@index([sortOrder])
}

model Service {
  id              String   @id @default(cuid())
  branchId        String
  categoryId      String
  nameHi          String   @db.VarChar(200)
  nameEn          String   @db.VarChar(200)
  slug            String   @db.VarChar(220)
  descriptionHi   String
  descriptionJson Json?
  descriptionHtml String?
  descriptionEn   String?
  price           Decimal  @db.Decimal(10, 2)
  advanceAmount   Decimal? @db.Decimal(10, 2)
  durationMinutes Int
  imageUrl        String?
  galleryUrls     String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings        Booking[]
  reviews         Review[]
  variants        ServiceVariant[]
  addOns          ServiceAddOn[]
  staffServices   StaffService[]
  offerServices   OfferService[]
  packageServices PackageService[]
  portfolioItems  PortfolioItem[]
  mediaAssets     MediaAsset[]

  @@unique([branchId, slug])
  @@index([categoryId, isActive])
  @@index([branchId, isActive])
  @@index([price])
}

model ServiceVariant {
  id              String   @id @default(cuid())
  serviceId       String
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  price           Decimal  @db.Decimal(10, 2)
  advanceAmount   Decimal? @db.Decimal(10, 2)
  durationMinutes Int
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([serviceId, isActive])
  @@index([sortOrder])
}

model ServiceAddOn {
  id              String   @id @default(cuid())
  branchId        String
  serviceId       String?
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingAddOns BookingAddOn[]

  @@index([branchId, isActive])
  @@index([serviceId, isActive])
}

model Package {
  id              String   @id @default(cuid())
  branchId        String
  categoryId      String?
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  slug            String   @db.VarChar(220)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  descriptionEn   String?
  price           Decimal  @db.Decimal(10, 2)
  advanceAmount   Decimal? @db.Decimal(10, 2)
  durationMinutes Int?
  imageUrl        String?
  isCustom        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  services       PackageService[]
  bookings       Booking[]
  consultations  Consultation[]
  portfolioItems PortfolioItem[]
  mediaAssets    MediaAsset[]
  reviews        Review[]

  @@unique([branchId, slug])
  @@index([branchId, isActive])
  @@index([categoryId])
}

model PackageService {
  packageId String
  serviceId String
  quantity  Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@index([sortOrder])
}

model Staff {
  id              String   @id @default(cuid())
  userId          String   @unique
  branchId        String
  specialization  String[] @default([])
  experienceYears Int?
  bioHi           String?
  bioJson         Json?
  bioHtml         String?
  bioEn           String?
  photoUrl        String?
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  isAvailable     Boolean  @default(true)
  workDays        Json     @default("{}")
  workStart       DateTime @db.Time(0)
  workEnd         DateTime @db.Time(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bookings       Booking[]
  reviews        Review[]
  consultations  Consultation[]
  portfolioItems PortfolioItem[]
  services       StaffService[]
  leaveRecords   StaffLeave[]
  commissions    StaffCommission[]
  mediaAssets    MediaAsset[]

  @@index([branchId, isAvailable])
  @@index([rating])
}

model StaffService {
  staffId   String
  serviceId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model StaffLeave {
  id        String   @id @default(cuid())
  staffId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
}

model Booking {
  id                 String        @id @default(cuid())
  displayId          String        @unique @db.VarChar(30)
  userId             String
  serviceId          String?
  serviceVariantId   String?
  packageId          String?
  staffId            String?
  branchId           String
  createdByUserId    String?
  bookingDate        DateTime      @db.Date
  slotStart          DateTime      @db.Time(0)
  slotEnd            DateTime      @db.Time(0)
  status             BookingStatus @default(PENDING)
  advanceAmount      Decimal?      @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  cancellationReason String?
  notes              String?
  notesJson          Json?
  notesHtml          String?
  pendingExpiresAt   DateTime?
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user                User                   @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Restrict)
  service             Service?               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariant      ServiceVariant?        @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  package             Package?               @relation(fields: [packageId], references: [id], onDelete: SetNull)
  staff               Staff?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  branch              Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy           User?                  @relation("CreatedBookings", fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments            Payment[]
  review              Review?
  offerRedemptions    OfferRedemption[]
  addOns              BookingAddOn[]
  notifications       Notification[]
  statusHistory       BookingStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]
  refunds             Refund[]
  staffCommissions    StaffCommission[]
  inventoryUsages     InventoryTransaction[]

  @@index([userId, bookingDate, status])
  @@index([staffId, bookingDate, slotStart])
  @@index([branchId, bookingDate])
  @@index([serviceId])
  @@index([serviceVariantId])
  @@index([packageId])
  @@index([status, pendingExpiresAt])
}

model BookingAddOn {
  bookingId String
  addOnId   String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  lineTotal Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   ServiceAddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@id([bookingId, addOnId])
  @@index([addOnId])
}

model BookingStatusHistory {
  id          String         @id @default(cuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String?
  reason      String?
  createdAt   DateTime       @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([changedById])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String
  userId            String
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  status            PaymentStatus   @default(CREATED)
  currency          String          @default("INR") @db.VarChar(3)
  amount            Decimal         @db.Decimal(10, 2)
  amountPaid        Decimal         @default(0) @db.Decimal(10, 2)
  amountRefunded    Decimal         @default(0) @db.Decimal(10, 2)
  paymentUrl        String?
  rawWebhookPayload Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Refund {
  id                 String       @id @default(cuid())
  paymentId          String
  bookingId          String
  providerRefundId   String?      @unique
  status             RefundStatus @default(REQUESTED)
  amount             Decimal      @db.Decimal(10, 2)
  reasonHi           String?
  reasonJson         Json?
  reasonHtml         String?
  rawProviderPayload Json?
  requestedAt        DateTime     @default(now())
  processedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@index([bookingId])
  @@index([status, requestedAt])
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  bookingId   String   @unique
  staffId     String?
  serviceId   String?
  packageId   String?
  rating      Int
  commentHi   String?
  commentJson Json?
  commentHtml String?
  photoUrls   String[] @default([])
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  mediaAssets MediaAsset[]

  @@index([serviceId, rating])
  @@index([packageId, rating])
  @@index([staffId, rating])
  @@index([isApproved, createdAt])
}

model Consultation {
  id            String             @id @default(cuid())
  userId        String
  branchId      String
  staffId       String?
  packageId     String?
  preferredDate DateTime?          @db.Date
  preferredTime DateTime?          @db.Time(0)
  status        ConsultationStatus @default(REQUESTED)
  notes         String?
  notesJson     Json?
  notesHtml     String?
  adminNotes    String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([branchId, preferredDate])
  @@index([staffId, preferredDate])
  @@index([packageId])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  userId        String
  branchId      String?
  label         String?  @db.VarChar(80)
  recipientName String?  @db.VarChar(100)
  mobile        String?  @db.VarChar(10)
  line1         String
  line2         String?
  landmark      String?
  city          String   @db.VarChar(100)
  state         String?  @db.VarChar(100)
  postalCode    String?  @db.VarChar(12)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, isDefault])
  @@index([city])
}

model PortfolioItem {
  id              String   @id @default(cuid())
  branchId        String
  staffId         String?
  serviceId       String?
  packageId       String?
  titleHi         String?  @db.VarChar(200)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  beforeImageUrl  String?
  afterImageUrl   String?
  imageUrls       String[] @default([])
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  mediaAssets MediaAsset[]

  @@index([branchId, isPublished, isFeatured])
  @@index([staffId])
  @@index([serviceId])
  @@index([packageId])
}

model Offer {
  id              String       @id @default(cuid())
  branchId        String?
  code            String       @unique @db.VarChar(20)
  titleHi         String       @db.VarChar(200)
  titleEn         String?      @db.VarChar(200)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  minOrder        Decimal?     @db.Decimal(10, 2)
  maxDiscount     Decimal?     @db.Decimal(10, 2)
  validFrom       DateTime
  validUntil      DateTime
  usageLimit      Int?
  usageCount      Int          @default(0)
  perUserLimit    Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services    OfferService[]
  redemptions OfferRedemption[]

  @@index([code, validUntil])
  @@index([branchId, isActive])
  @@index([validFrom, validUntil])
}

model OfferService {
  offerId   String
  serviceId String
  createdAt DateTime @default(now())

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([offerId, serviceId])
  @@index([serviceId])
}

model OfferRedemption {
  id             String   @id @default(cuid())
  offerId        String
  bookingId      String
  userId         String
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([offerId, bookingId])
  @@index([userId, createdAt])
  @@index([offerId, createdAt])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String?
  branchId          String?
  bookingId         String?
  channel           NotificationChannel
  trigger           NotificationTrigger
  recipient         String
  templateKey       String?             @db.VarChar(120)
  messageHi         String
  provider          String?             @db.VarChar(80)
  providerMessageId String?
  status            NotificationStatus  @default(QUEUED)
  retryCount        Int                 @default(0)
  scheduledAt       DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([channel, status, scheduledAt])
  @@index([trigger, createdAt])
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String
  bookingId String?
  type      LoyaltyTransactionType
  points    Int
  reasonHi  String?
  expiresAt DateTime?
  createdAt DateTime               @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RevenueSnapshot {
  id             String   @id @default(cuid())
  branchId       String
  date           DateTime @db.Date
  bookingCount   Int      @default(0)
  completedCount Int      @default(0)
  cancelledCount Int      @default(0)
  grossRevenue   Decimal  @default(0) @db.Decimal(12, 2)
  advanceRevenue Decimal  @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
}

model ProductCategory {
  id              String   @id @default(cuid())
  branchId        String?
  slugScope       String   @default("global") @db.VarChar(120)
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  slug            String   @db.VarChar(220)
  description     String?
  descriptionJson Json?
  descriptionHtml String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([branchId, slug])
  @@unique([slugScope, slug])
  @@index([branchId, isActive])
}

model Product {
  id              String   @id @default(cuid())
  branchId        String
  categoryId      String?
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  slug            String   @db.VarChar(220)
  descriptionHi   String?
  descriptionJson Json?
  descriptionHtml String?
  price           Decimal  @db.Decimal(10, 2)
  stockQuantity   Int      @default(0)
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category       ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      ProductSaleItem[]
  inventoryItems InventoryItem[]
  mediaAssets    MediaAsset[]

  @@unique([branchId, slug])
  @@index([branchId, isActive])
  @@index([categoryId])
}

model ProductSale {
  id             String            @id @default(cuid())
  branchId       String
  userId         String?
  status         ProductSaleStatus @default(DRAFT)
  subtotal       Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal           @db.Decimal(10, 2)
  notes          String?
  notesJson      Json?
  notesHtml      String?
  soldAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            ProductSaleItem[]
  staffCommissions StaffCommission[]

  @@index([branchId, status, createdAt])
  @@index([userId, createdAt])
}

model ProductSaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  sale                  ProductSale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]

  @@index([saleId])
  @@index([productId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  branchId       String
  productId      String?
  nameHi         String   @db.VarChar(200)
  nameEn         String?  @db.VarChar(200)
  sku            String?  @db.VarChar(80)
  unit           String   @default("piece") @db.VarChar(40)
  quantityOnHand Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal? @db.Decimal(12, 3)
  costPerUnit    Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product      Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions InventoryTransaction[]

  @@unique([branchId, sku])
  @@index([branchId, isActive])
  @@index([productId])
}

model InventoryTransaction {
  id                String                   @id @default(cuid())
  inventoryItemId   String
  bookingId         String?
  productSaleItemId String?
  type              InventoryTransactionType
  quantityChange    Decimal                  @db.Decimal(12, 3)
  unitCost          Decimal?                 @db.Decimal(10, 2)
  notes             String?
  notesJson         Json?
  notesHtml         String?
  createdAt         DateTime                 @default(now())

  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  productSaleItem ProductSaleItem? @relation(fields: [productSaleItemId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([bookingId])
  @@index([productSaleItemId])
  @@index([type, createdAt])
}

model Expense {
  id          String          @id @default(cuid())
  branchId    String
  createdById String?
  category    ExpenseCategory
  titleHi     String          @db.VarChar(200)
  titleJson   Json?
  titleHtml   String?
  amount      Decimal         @db.Decimal(10, 2)
  expenseDate DateTime        @db.Date
  vendorName  String?
  receiptUrl  String?
  notes       String?
  notesJson   Json?
  notesHtml   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, expenseDate])
  @@index([category, expenseDate])
  @@index([createdById])
}

model StaffCommission {
  id               String                @id @default(cuid())
  staffId          String
  bookingId        String?
  productSaleId    String?
  status           StaffCommissionStatus @default(PENDING)
  baseAmount       Decimal               @db.Decimal(10, 2)
  commissionRate   Decimal?              @db.Decimal(5, 2)
  commissionAmount Decimal               @db.Decimal(10, 2)
  paidAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  staff       Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  productSale ProductSale? @relation(fields: [productSaleId], references: [id], onDelete: SetNull)

  @@index([staffId, status])
  @@index([bookingId])
  @@index([productSaleId])
  @@index([status, createdAt])
}

model MediaAsset {
  id               String         @id @default(cuid())
  branchId         String?
  serviceId        String?
  packageId        String?
  staffId          String?
  portfolioItemId  String?
  reviewId         String?
  blogPostId       String?
  productId        String?
  ownerType        MediaOwnerType
  url              String
  provider         String?        @db.VarChar(80)
  providerPublicId String?
  altHi            String?
  altJson          Json?
  altHtml          String?
  sortOrder        Int            @default(0)
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now())

  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  staff         Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  review        Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  blogPost      BlogPost?      @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerType, createdAt])
  @@index([branchId])
  @@index([serviceId])
  @@index([packageId])
  @@index([staffId])
  @@index([portfolioItemId])
  @@index([reviewId])
  @@index([blogPostId])
  @@index([productId])
}

model BlogCategory {
  id              String   @id @default(cuid())
  nameHi          String   @db.VarChar(200)
  nameEn          String?  @db.VarChar(200)
  slug            String   @unique @db.VarChar(220)
  description     String?
  descriptionJson Json?
  descriptionHtml String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts BlogPost[]

  @@index([isActive, sortOrder])
}

model BlogPost {
  id            String         @id @default(cuid())
  categoryId    String
  authorId      String?
  titleHi       String         @db.VarChar(240)
  titleEn       String?        @db.VarChar(240)
  slug          String         @unique @db.VarChar(260)
  excerptHi     String?
  excerptJson   Json?
  excerptHtml   String?
  contentHi     String
  contentJson   Json?
  contentHtml   String?
  coverImageUrl String?
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category    BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author      User?        @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  mediaAssets MediaAsset[]

  @@index([categoryId, status])
  @@index([status, publishedAt])
}
