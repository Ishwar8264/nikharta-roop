# ------------------------------------------------------------------
# Nikharta Roop — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Core ----------------------------------------------------------
# PostgreSQL connection string (supports ?sslmode=...)
DATABASE_URL="postgresql://user:password@localhost:5432/nikharta_roop"

# Public URLs used for application links and SEO.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
APP_ORIGIN="http://localhost:3000"

# --- Rate limiting (required in production; optional in dev) -------
# Leave both empty for the local in-memory fallback.
# For production, set both to real credentials from your Upstash Redis database.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Media (Cloudinary) --------------------------------------------
# Browser-side upload preset uses this public value:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Server-side signed deletion:
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- Notification email (Resend) -----------------------------------
# RESEND_API_KEY=""
# EMAIL_FROM="Nikharta Roop <notifications@resend.dev>"

# --- SMS / WhatsApp notifications -----------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_SMS_FROM=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# --- AI assistant ----------------------------------------------------
# OPENAI_API_KEY=""
# AI_MODEL=""
# AI_PROVIDER=""

# --- Notifications ---------------------------------------------------
# FCM_SERVER_KEY=""

# --- Cron (Vercel Cron / vercel-local-cron) -------------------------
# CRON_SECRET=""

# --- API docs (Swagger UI) ------------------------------------------
# API_DOCS_ENABLED="true"
