# ------------------------------------------------------------------
# Nikharta Roop — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Core ----------------------------------------------------------
# PostgreSQL connection string (supports ?sslmode=...)
DATABASE_URL="postgresql://user:password@localhost:5432/nikharta_roop"

# Access-token signing secret. MUST be at least 32 bytes.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-bytes"

# Public URLs used for CSRF origin checks, OAuth redirects, and SEO.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
APP_ORIGIN="http://localhost:3000"

# --- Rate limiting (required in production; optional in dev) -------
# Leave both empty for the local in-memory fallback.
# For production, set both to real credentials from your Upstash Redis database.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Media (Cloudinary) --------------------------------------------
# Browser-side upload preset uses this public value:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Server-side signed deletion:
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- Email (Resend) -------------------------------------------------
# RESEND_API_KEY=""
# EMAIL_FROM="Nikharta Roop <onboarding@resend.dev>"

# --- SMS / WhatsApp OTP (Twilio / WhatsApp Cloud API) ---------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_SMS_FROM=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# --- OAuth providers ------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/oauth/google/callback"
# APPLE_OAUTH_CLIENT_ID=""
# APPLE_OAUTH_TEAM_ID=""
# APPLE_OAUTH_KEY_ID=""
# APPLE_OAUTH_PRIVATE_KEY=""
# APPLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/oauth/apple/callback"
# FACEBOOK_OAUTH_CLIENT_ID=""
# FACEBOOK_OAUTH_CLIENT_SECRET=""
# FACEBOOK_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/oauth/facebook/callback"
# OAUTH_SUCCESS_REDIRECT="http://localhost:3000"
# OAUTH_FAILURE_REDIRECT="http://localhost:3000/login"

# --- AI assistant ----------------------------------------------------
# OPENAI_API_KEY=""
# AI_MODEL=""
# AI_PROVIDER=""

# --- Notifications ---------------------------------------------------
# FCM_SERVER_KEY=""

# --- Cron (Vercel Cron / vercel-local-cron) -------------------------
# CRON_SECRET=""

# --- API docs (Swagger UI) ------------------------------------------
# API_DOCS_ENABLED="true"
