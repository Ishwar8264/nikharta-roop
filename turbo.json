{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "AI_MODEL",
        "AI_PROVIDER",
        "API_DOCS_ENABLED",
        "APPLE_OAUTH_CLIENT_ID",
        "APPLE_OAUTH_KEY_ID",
        "APPLE_OAUTH_PRIVATE_KEY",
        "APPLE_OAUTH_REDIRECT_URI",
        "APPLE_OAUTH_TEAM_ID",
        "APP_ORIGIN",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "EMAIL_FROM",
        "FACEBOOK_OAUTH_CLIENT_ID",
        "FACEBOOK_OAUTH_CLIENT_SECRET",
        "FACEBOOK_OAUTH_REDIRECT_URI",
        "FCM_SERVER_KEY",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI",
        "JWT_SECRET",
        "LOCAL_SALON_VERIFICATION_BYPASS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "NODE_ENV",
        "OAUTH_FAILURE_REDIRECT",
        "OAUTH_SUCCESS_REDIRECT",
        "OPENAI_API_KEY",
        "RESEND_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_SMS_FROM",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "AI_MODEL",
        "AI_PROVIDER",
        "API_DOCS_ENABLED",
        "APPLE_OAUTH_CLIENT_ID",
        "APPLE_OAUTH_KEY_ID",
        "APPLE_OAUTH_PRIVATE_KEY",
        "APPLE_OAUTH_REDIRECT_URI",
        "APPLE_OAUTH_TEAM_ID",
        "APP_ORIGIN",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "EMAIL_FROM",
        "FACEBOOK_OAUTH_CLIENT_ID",
        "FACEBOOK_OAUTH_CLIENT_SECRET",
        "FACEBOOK_OAUTH_REDIRECT_URI",
        "FCM_SERVER_KEY",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI",
        "JWT_SECRET",
        "LOCAL_SALON_VERIFICATION_BYPASS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "NODE_ENV",
        "OAUTH_FAILURE_REDIRECT",
        "OAUTH_SUCCESS_REDIRECT",
        "OPENAI_API_KEY",
        "RESEND_API_KEY",
        "RUN_ACCOUNT_DATABASE_TESTS",
        "RUN_STAFF_DATABASE_TESTS",
        "RUN_VERIFICATION_DATABASE_TESTS",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_SMS_FROM",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "env": [
        "AI_MODEL",
        "AI_PROVIDER",
        "API_DOCS_ENABLED",
        "APPLE_OAUTH_CLIENT_ID",
        "APPLE_OAUTH_KEY_ID",
        "APPLE_OAUTH_PRIVATE_KEY",
        "APPLE_OAUTH_REDIRECT_URI",
        "APPLE_OAUTH_TEAM_ID",
        "APP_ORIGIN",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "EMAIL_FROM",
        "FACEBOOK_OAUTH_CLIENT_ID",
        "FACEBOOK_OAUTH_CLIENT_SECRET",
        "FACEBOOK_OAUTH_REDIRECT_URI",
        "FCM_SERVER_KEY",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI",
        "JWT_SECRET",
        "LOCAL_SALON_VERIFICATION_BYPASS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "NODE_ENV",
        "OAUTH_FAILURE_REDIRECT",
        "OAUTH_SUCCESS_REDIRECT",
        "OPENAI_API_KEY",
        "RESEND_API_KEY",
        "RUN_ACCOUNT_DATABASE_TESTS",
        "RUN_STAFF_DATABASE_TESTS",
        "RUN_VERIFICATION_DATABASE_TESTS",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_SMS_FROM",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
      ]
    },
    "@nikharta-roop/db#typecheck": {
      "dependsOn": ["db:generate", "^typecheck"],
      "cache": false
    }
  }
}
