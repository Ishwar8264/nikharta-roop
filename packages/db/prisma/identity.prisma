// Account setup, public user details, and salon membership have independent responsibilities.
enum UserProfileStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// One public profile per person. Actions and permissions belong to User, not this display record.
model UserProfile {
  id          String            @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status      UserProfileStatus @default(DRAFT)
  slug        String            @unique @default(dbgenerated("('profile-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  displayName String?
  avatar      String?
  coverImage  String?
  bio         String?
  bioHtml     String?
  bioJson     Json?
  bioFormat   ContentFormat     @default(TEXT)
  lat         Float?
  lng         Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
}

// Account onboarding/consent is business state, not a public profile or login role.
// Preserve the existing completion flag during migration; do not invent past dates.
model UserOnboarding {
  userId                         String       @id
  currentStep                    String?
  draft                          Json?
  updatedAt                      DateTime     @default(now()) @updatedAt
  // Signup preference only; never restrict booking or salon ownership using this field.
  accountType                    AccountType?
  isOnboarded                    Boolean      @default(false)
  onboardingCompletedAt          DateTime?
  partnerCompletedAt             DateTime?
  partnerTermsVersion            String?
  partnerTermsAcceptedAt         DateTime?
  partnerEligibilityBackfilledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Spendable points belong to the real person, never a shared salon identity.
// LoyaltyTransaction remains the ledger; balance and ledger updates must be atomic.
model LoyaltyWallet {
  userId    String   @id
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}
