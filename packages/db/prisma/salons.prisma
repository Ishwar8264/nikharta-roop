// Salons models. Existing table names and stored values remain unchanged.

enum SalonStatus {
  DRAFT
  LIVE
  TEMPORARILY_CLOSED
  ARCHIVED
}

enum SalonMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum SalonCategory {
  MALE
  FEMALE
  UNISEX
  KIDS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SalonVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Salon {
  id String @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))

  category SalonCategory @default(UNISEX)

  description       String?
  descriptionHtml   String?
  descriptionJson   Json?
  descriptionFormat ContentFormat @default(TEXT)

  address  String?
  city     String?
  state    String?
  zip      String?
  country  String  @default("IN")
  timezone String  @default("Asia/Kolkata")
  lat      Float?
  lng      Float?
  placeId  String? @unique

  phone  String?
  email  String?
  images String[] @default([]) // Gallery

  status    SalonStatus @default(DRAFT)
  isActive  Boolean     @default(false)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members        SalonMember[]
  workingHours   SalonWorkingHours[]
  services       Service[]
  products       Product[]
  appointments   Appointment[]
  favorites      Favorite[]
  staffSchedules StaffSchedule[]
  staffLeaves    StaffLeave[]
  verification   SalonVerification?
  settings       SalonSettings?
  templates      SalonTemplate[]
  packages       Package[]
  coupons        Coupon[]
  payouts        Payout[]
  customerNotes  CustomerNote[]

  profile Profile?

  @@index([city])
  @@index([isActive])
}

model SalonVerification {
  id          String                    @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId     String                    @unique
  salon       Salon                     @relation(fields: [salonId], references: [id])
  status      SalonVerificationStatus   @default(PENDING)
  documents   Json? // KYC docs (pan, shop license, photos) — URL/ref list
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewer    User?                     @relation(fields: [reviewedBy], references: [id])
  reason      String? // rejection reason
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  reviews     SalonVerificationReview[]

  @@index([status])
}

model SalonVerificationReview {
  id             String                  @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  verificationId String
  verification   SalonVerification       @relation(fields: [verificationId], references: [id])
  reviewerId     String
  status         SalonVerificationStatus
  reason         String?
  submission     Json
  evidence       Json?
  createdAt      DateTime                @default(now())

  @@index([verificationId, createdAt])
}

model SalonSettings {
  salonId                 String   @id
  salon                   Salon    @relation(fields: [salonId], references: [id])
  bufferMinutes           Int      @default(10) // appointments ke beech cleanup gap
  advanceBookingDays      Int      @default(30)
  cancellationWindowHours Int      @default(4)
  noShowFee               Decimal? @db.Decimal(12, 2)
  acceptsAdvancePayments  Boolean  @default(true) // token booking on/off
  walkInsAllowed          Boolean  @default(true)
}

model SalonWorkingHours {
  id        String    @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  day       DayOfWeek
  openTime  String // "09:00"
  closeTime String // "21:00"
  isClosed  Boolean   @default(false) // Weekly off

  @@unique([salonId, day])
}

model SalonMember {
  id          String          @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  userId      String
  salonId     String
  role        SalonMemberRole
  slug        String          @default(dbgenerated("('staff-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  name        String?
  avatar      String?
  bannerImage String?
  title       String?
  description String?

  user  User  @relation(fields: [userId], references: [id])
  salon Salon @relation(fields: [salonId], references: [id])

  @@unique([userId, salonId])
  @@unique([salonId, slug])
  @@index([salonId, role])
}

model StaffSchedule {
  id        String    @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  staffId   String
  staff     User      @relation(fields: [staffId], references: [id])
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  day       DayOfWeek
  startTime String // "10:00"
  endTime   String // "19:00"
  isOff     Boolean   @default(false)

  @@unique([staffId, salonId, day])
}

model StaffLeave {
  slug      String   @unique @default(dbgenerated("('staff-leave-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id        String   @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId, salonId, startDate, endDate])
}

model StaffServiceSkill {
  id         String   @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  staffId    String
  serviceId  String
  experience Int? // years
  createdAt  DateTime @default(now())
  staff      User     @relation(fields: [staffId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([staffId, serviceId])
}
