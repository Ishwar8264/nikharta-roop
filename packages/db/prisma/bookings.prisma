// Bookings models. Existing table names and stored values remain unchanged.

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  ONLINE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum PaymentTxnType {
  ADVANCE
  FINAL
  REFUND
}

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
}

model Coupon {
  id                String        @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  code              String        @unique
  shortDescription  String?
  description       String?
  descriptionHtml   String?
  descriptionJson   Json?
  descriptionFormat ContentFormat @default(TEXT)
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2) // % ya flat amount
  minOrderAmount    Decimal?      @db.Decimal(12, 2) // Minimum appointment total
  maxDiscount       Decimal?      @db.Decimal(12, 2) // Cap for percentage
  usageLimit        Int? // Total uses
  usedCount         Int           @default(0)
  perUserLimit      Int           @default(1)
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())

  // null = platform-wide coupon; set = sirf us salon ke bookings pe lagu.
  salonId String?
  salon   Salon?  @relation(fields: [salonId], references: [id])

  appointments Appointment[]

  @@index([salonId, isActive])
}

model Appointment {
  slug       String @unique @default(dbgenerated("('booking-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id         String @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  staffId String? // Primary staff assigned
  staff   User?   @relation("AppointmentPrimaryStaff", fields: [staffId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  notes           String?
  cancelReason    String?
  rescheduledFrom String? // Original appointment ID

  services            AppointmentService[]
  payment             Payment?
  staffRatings        StaffRating[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([salonId, startTime])
  @@index([staffId, startTime, endTime])
  @@index([status])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  staffId       String? // Specific staff for this service
  staff         User?       @relation("AppointmentServiceStaff", fields: [staffId], references: [id])
  price         Decimal     @db.Decimal(12, 2) // Price at time of booking
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([staffId])
}

model Payment {
  slug          String        @unique @default(dbgenerated("('payment-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id            String        @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CASH)
  transactionId String?
  gatewayRef    String? // Razorpay/Stripe reference
  refundAmount  Decimal?      @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
}

model PaymentTransaction {
  slug           String         @unique @default(dbgenerated("('transaction-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id             String         @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  appointmentId  String
  appointment    Appointment    @relation(fields: [appointmentId], references: [id])
  type           PaymentTxnType
  amount         Decimal        @db.Decimal(12, 2)
  commission     Decimal        @default(0) @db.Decimal(12, 2) // platform cut
  method         PaymentMethod  @default(CASH)
  gatewayRef     String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  @@index([appointmentId, createdAt(sort: Desc)])
}

model Payout {
  slug        String       @unique @default(dbgenerated("('payout-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id          String       @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id])
  period      String // "2026-10"
  amount      Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([salonId, status])
}
