// Direct conversations belong to two individual users, independently of salon membership.
model Conversation {
  id           String                    @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  slug         String                    @unique @default(dbgenerated("('chat-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  firstUserId  String
  secondUserId String
  createdAt    DateTime                  @default(now())
  firstUser    User                      @relation("FirstConversationUser", fields: [firstUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  secondUser   User                      @relation("SecondConversationUser", fields: [secondUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@unique([firstUserId, secondUserId])
  @@index([secondUserId])
}

// Composite sender references keep users outside the conversation from sending messages.
model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sentMessages   ChatMessage[]           @relation("ConversationSender")
  readStates     ConversationReadState[]

  @@id([conversationId, userId])
  @@index([userId, conversationId])
}

model ChatMessage {
  id              String                  @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  slug            String                  @unique @default(dbgenerated("('message-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  conversationId  String
  senderId        String
  clientMessageId String                  @db.VarChar(128)
  body            String?
  bodyHtml        String?
  bodyJson        Json?
  bodyFormat      ContentFormat           @default(TEXT)
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender          User                    @relation(fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participant     ConversationParticipant @relation("ConversationSender", fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Restrict, onUpdate: Restrict)
  replyTo         ChatMessage?            @relation("ChatMessageReplies", fields: [conversationId, replyToId], references: [conversationId, id], onDelete: Restrict, onUpdate: Restrict)
  replies         ChatMessage[]           @relation("ChatMessageReplies")
  media           ChatMessageMedia[]
  readBy          ConversationReadState[] @relation("LastReadMessage")

  @@unique([conversationId, id])
  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId])
  @@index([senderId])
}

model ChatMessageMedia {
  messageId String
  mediaId   String
  position  Int         @default(0)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([messageId, mediaId])
  @@unique([messageId, position])
  @@index([mediaId])
}

// Every user has their own cursor; it must reference a message in the same conversation.
model ConversationReadState {
  conversationId    String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime?
  updatedAt         DateTime                @updatedAt
  participant       ConversationParticipant @relation(fields: [conversationId, userId], references: [conversationId, userId], onDelete: Restrict, onUpdate: Restrict)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastReadMessage   ChatMessage?            @relation("LastReadMessage", fields: [conversationId, lastReadMessageId], references: [conversationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([conversationId, lastReadMessageId])
}
