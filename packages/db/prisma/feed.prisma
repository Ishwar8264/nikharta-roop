enum FeedPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

model FeedPost {
  slug        String         @unique @default(dbgenerated("('post-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id          String         @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  authorId    String
  body        String?
  bodyHtml    String?
  bodyJson    Json?
  bodyFormat  ContentFormat  @default(TEXT)
  status      FeedPostStatus @default(DRAFT)
  publishedAt DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // The individual user is the author; salons never act as identities.
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media    FeedPostMedia[]
  comments FeedComment[]
  likes    FeedLike[]

  @@index([status, publishedAt(sort: Desc), id])
  @@index([authorId, status, createdAt(sort: Desc), id])
  @@index([authorId])
}

model FeedPostMedia {
  postId   String
  mediaId  String
  position Int     @default(0)
  altText  String?

  post  FeedPost   @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([postId, mediaId])
  @@unique([postId, position])
  @@index([mediaId])
}

model FeedComment {
  slug       String        @unique @default(dbgenerated("('comment-'::text || encode(gen_random_bytes(8), 'hex'::text))")) @db.VarChar(120)
  id         String        @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  postId     String
  authorId   String
  parentId   String?
  body       String        @default("")
  bodyHtml   String?
  bodyJson   Json?
  bodyFormat ContentFormat @default(TEXT)
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  post    FeedPost      @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // A reply cannot reference a comment on another post.
  parent  FeedComment?  @relation("FeedCommentReplies", fields: [postId, parentId], references: [postId, id], onDelete: Restrict, onUpdate: Restrict)
  replies FeedComment[] @relation("FeedCommentReplies")

  @@unique([postId, id])
  @@index([postId, parentId, createdAt, id])
  @@index([authorId])
}

// One like per individual user.
model FeedLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@index([userId])
}
