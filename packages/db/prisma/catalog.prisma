// Catalog models. Existing table names and stored values remain unchanged.

enum CatalogStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

model ServiceCategory {
  id               String            @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  name             String // "Hair", "Skin", "Nails", "Beard"
  slug             String            @unique
  icon             String?
  services         Service[]
  catalogTemplates CatalogTemplate[]
}

model CatalogTemplate {
  id          String           @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  key         String           @unique // stable ref, e.g. "svc.haircut.men" — seed/API ke liye
  kind        String // "SERVICE" | "PACKAGE"
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  icon        String?
  isActive    Boolean          @default(true) // platform side on/off
  sortOrder   Int              @default(0)

  salonActivations SalonTemplate[]

  @@index([kind, isActive])
}

model SalonTemplate {
  id         String          @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId    String
  salon      Salon           @relation(fields: [salonId], references: [id])
  templateId String
  template   CatalogTemplate @relation(fields: [templateId], references: [id])
  price      Decimal         @db.Decimal(12, 2)
  isActive   Boolean         @default(true) // salon ne activate kiya ya nahi

  @@unique([salonId, templateId])
  @@index([templateId])
}

model Service {
  id         String           @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId    String
  salon      Salon            @relation(fields: [salonId], references: [id])
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  name      String
  slug      String
  price     Decimal       @db.Decimal(12, 2)
  duration  Int // minutes
  status    CatalogStatus @default(DRAFT)
  isActive  Boolean       @default(false)
  deletedAt DateTime?

  // Description (same as product - flexible)
  shortDescription  String?
  description       String?
  descriptionHtml   String?
  descriptionJson   Json?
  descriptionFormat ContentFormat @default(TEXT)

  // SEO

  coverImage  String?
  bannerImage String?
  images      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews      ServiceReview[]
  appointments AppointmentService[]
  favorites    Favorite[]
  staffSkills  StaffServiceSkill[]
  packages     PackageService[]

  @@unique([salonId, slug])
  @@index([salonId, isActive, deletedAt])
}

model ProductCategory {
  id       String    @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id         String           @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId    String
  salon      Salon            @relation(fields: [salonId], references: [id])
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  name        String
  price       Decimal       @db.Decimal(12, 2)
  stock       Int
  coverImage  String?
  bannerImage String?
  images      String[]
  status      CatalogStatus @default(DRAFT)
  isActive    Boolean       @default(false)
  deletedAt   DateTime?

  slug              String
  shortDescription  String?
  description       String?
  descriptionHtml   String?
  descriptionJson   Json?
  descriptionFormat ContentFormat @default(TEXT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   ProductReview[]
  favorites Favorite[]

  @@unique([salonId, slug])
  @@index([salonId, isActive, deletedAt])
}

model Package {
  id        String        @id @default(dbgenerated("(encode(gen_random_bytes(24), 'hex'::text))"))
  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id])
  name      String // "Bridal Royal Package"
  slug      String
  price     Decimal       @db.Decimal(12, 2)
  duration  Int // minutes
  status    CatalogStatus @default(DRAFT)
  isActive  Boolean       @default(false)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  services PackageService[]

  @@unique([salonId, slug])
  @@index([salonId, isActive, deletedAt])
}

model PackageService {
  packageId String
  serviceId String
  package   Package @relation(fields: [packageId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([packageId, serviceId])
  @@index([serviceId])
}
